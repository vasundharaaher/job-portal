DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*

# ── Database Configuration ──
# Options: 'sqlite' or 'mysql'
DB_ENGINE=sqlite

# MySQL configuration (used when DB_ENGINE=mysql)
DB_NAME=jobportal_db_final
